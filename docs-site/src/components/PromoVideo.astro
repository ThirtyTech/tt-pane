---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section class="promo not-content" aria-labelledby="promo-heading">
  <div class="promo-copy">
    <p class="promo-label">SEE TT-PANE IN ACTION · 42 SECONDS</p>
    <h2 id="promo-heading">Workspace, evolved.</h2>
    <p>From desktop chaos to everything in place. See how a few keys can change your flow.</p>
    <a href="https://www.youtube.com/watch?v=eov7tVFdQfA" target="_blank" rel="noopener noreferrer">Watch on YouTube <span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span></a>
  </div>
  <video controls playsinline preload="none" poster={`${base}/media/tt-pane-promo-thumbnail.png`} aria-label="tt-pane promo: Workspace, evolved">
    <source src="https://thirtytech-my.sharepoint.com/:v:/g/personal/jsheely_thirtytech_net/IQC0yxRKfde-TbFlqNtFvbLkASndhWPRJjthWaNDysnAyis?e=ksWshD&amp;download=1" type="video/mp4" />
    <p><a href="https://www.youtube.com/watch?v=eov7tVFdQfA">Watch the tt-pane promo on YouTube.</a></p>
  </video>
</section>



<style>
  .promo { display: grid; grid-template-columns: .7fr 1.3fr; align-items: center; gap: 2.5rem; padding: 2rem; margin-bottom: 3rem; border: 1px solid var(--line); border-radius: 14px; background: var(--surface); }
  .promo-copy { min-width: 0; }
  .promo-label { margin: 0 0 1rem; font-size: .7rem; font-weight: 700; letter-spacing: .1em; color: var(--mint); }
  h2 { margin: 0; font-size: clamp(1.8rem, 3vw, 2.6rem); line-height: 1.1; letter-spacing: -.04em; color: var(--ink); }
  .promo-copy > p:not(.promo-label) { margin: 1rem 0 1.5rem; color: var(--muted); line-height: 1.7; }
  .promo-copy > a { display: inline-flex; align-items: center; gap: .7rem; min-height: 44px; color: var(--secondary); font-weight: 600; text-underline-offset: 4px; }
  video { display: block; width: 100%; min-width: 0; aspect-ratio: 16 / 9; border-radius: 8px; background: #06121e; }
  a:focus-visible, video:focus-visible { outline: 2px solid var(--mint); outline-offset: 4px; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  @media (max-width: 50rem) { .promo { grid-template-columns: 1fr; gap: 1.5rem; padding: 1.25rem; } }
</style>
