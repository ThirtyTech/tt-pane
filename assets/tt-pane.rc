101 ICON "assets/tt-pane.ico"

1 VERSIONINFO
FILEVERSION APP_VERSION_NUMERIC
PRODUCTVERSION APP_VERSION_NUMERIC
FILEFLAGSMASK 0x3fL
FILEFLAGS 0
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "tt-pane"
            VALUE "FileVersion", APP_VERSION
            VALUE "InternalName", "tt-pane"
            VALUE "OriginalFilename", "tt-pane.exe"
            VALUE "ProductName", "tt-pane"
            VALUE "ProductVersion", APP_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
